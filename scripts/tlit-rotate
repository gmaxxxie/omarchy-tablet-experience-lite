#!/usr/bin/env bash
# tlit-rotate — rotate the primary display (detachable tablet experience).
#
# Usage: tlit-rotate [-s] [--scale <V>] <0|1|2|3|next|prev>
#   -s   silent: skip the OSD notification (sensor-following, and callers that
#                 show their own, pass this)
#   --scale <V>   override the monitor scale instead of preserving the
#                 current one
#   0 = landscape  1 = portrait 90°  2 = flipped 180°  3 = portrait 270°
#   next            +1 (content turns clockwise; what you want when turning the
#                   device to the left)
#   prev            -1
#
# Prints the resulting transform (0-3) as the last stdout line, so the caller
# can persist the angle after a relative step.
#
# Display: defaults to the FIRST Hyprland monitor (usually the internal
# panel); override with OMARCHY_ROTATE_DISPLAY.
#
# Uses the Hyprland 0.56 Lua runtime API (hyprctl eval).
#
# Touch alignment: Hyprland does NOT re-map touch coords when the output
# rotates — the touch device keeps libinput's calibration matrix
# (input:touchdevice:transform, default 0 = identity), so a rotated screen
# would mis-map taps. The touch-device transform is therefore set to the SAME
# value as the monitor transform.
set -eu

SILENT=0
OPT_SCALE=""
ARG=""
while [ "$#" -gt 0 ]; do
  case "$1" in
    -s|--silent) SILENT=1; shift ;;
    --scale) OPT_SCALE="${2:-}"; shift 2 ;;
    --scale=*) OPT_SCALE="${1#--scale=}"; shift ;;
    *) ARG="$1"; shift ;;
  esac
done
ARG="${ARG:-0}"

WANT="${OMARCHY_ROTATE_DISPLAY:-}"

# One `hyprctl monitors -j` per rotation, parsed once into
# "name<TAB>transform<TAB>scale". jq starts in 3 ms where python3 needs 30 ms,
# and the monitor set is small either way; python is only the fallback.
read_monitors() {
  local json line=""
  json="$(hyprctl monitors -j 2>/dev/null)" || json=""
  if [ -n "$json" ]; then
    if command -v jq >/dev/null 2>&1; then
      line="$(printf '%s' "$json" | jq -r --arg want "$WANT" '
        (if $want == "" then .[0] else first(.[] | select(.name == $want)) end)
        | "\(.name)\t\(.transform // 0)\t\(.scale // 1)"' 2>/dev/null || true)"
    else
      line="$(printf '%s' "$json" | python3 -c 'import json, sys
monitors = json.load(sys.stdin)
want = sys.argv[1]
monitor = next((m for m in monitors if m.get("name") == want), None) if want \
    else (monitors[0] if monitors else None)
if monitor:
    print("\t".join([str(monitor.get("name")),
                     str(monitor.get("transform") or 0),
                     str(monitor.get("scale") or 1)]))' "$WANT" 2>/dev/null || true)"
    fi
  fi
  printf '%s\n' "$line"
}

line="$(read_monitors)"
[ -n "$line" ] || line="${WANT:-eDP-1}	0	1"
IFS=$'\t' read -r DISP CUR CUR_SCALE <<<"$line"
[ -n "${DISP:-}" ] || DISP="${WANT:-eDP-1}"
case "${CUR:-}" in 0|1|2|3) ;; *) CUR=0 ;; esac

case "$ARG" in
  0|1|2|3) N="$ARG" ;;
  next) N=$(( (CUR + 1) % 4 )) ;;
  prev) N=$(( (CUR + 3) % 4 )) ;;
  *) echo "usage: tlit-rotate [-s] [--scale V] <0|1|2|3|next|prev>" >&2; exit 2 ;;
esac

case "$N" in
  0) label="landscape 0°" ;;
  1) label="portrait 90°" ;;
  2) label="flipped 180°" ;;
  3) label="portrait 270°" ;;
esac

# Preserve the monitor scale: hl.monitor() without a scale field re-derives a
# default from EDID/DPI and silently resets the user's scale (observed
# 1.25 -> 1.6 on a laptop->tablet->laptop round trip). Default = keep the
# CURRENT scale so rotation never changes it; --scale overrides.
if [ -n "$OPT_SCALE" ]; then
  SCALE="$OPT_SCALE"
else
  SCALE="${CUR_SCALE:-1}"
fi
case "$SCALE" in
  ''|*[!0-9.]*) SCALE=1 ;;
esac

hyprctl eval "hl.monitor({ output = \"${DISP}\", transform = ${N}, scale = ${SCALE} })" >/dev/null
# Keep the touch device's calibration matrix in step with the screen, or taps
# land mirrored/mis-mapped on a rotated display.
hyprctl eval "hl.config({ input = { touchdevice = { transform = ${N} } } })" >/dev/null 2>&1 || true
if [ "$SILENT" -eq 0 ]; then
  omarchy osd -i rotate-cw -m "Rotate: ${label}" >/dev/null 2>&1 || true
fi

printf '%s\n' "$N"
