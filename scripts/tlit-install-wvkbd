#!/usr/bin/env bash
# ============================================================================
# tlit-install-wvkbd — build wvkbd-deskintl for the current user.
#
# The lite plugin's keyboard is wvkbd-deskintl (deskintl layout): wlroots
# native, with Ctrl / Super / Alt / Shift / AltGr, F1-F12, a full number row
# and arrows. The Arch `wvkbd` package only ships the phone-style
# `wvkbd-mobintl`, so this helper builds the deskintl binary from the pinned
# upstream tarball and applies the lite patch: a visible ▼ collapse key that
# folds the keyboard away (wvkbd ships no dismiss key).
#
# Everything runs as the user and installs to ~/.local/bin — no sudo, no
# root-owned build tree, no SDDM/greeter copy. tlit-vk prefers that path, and
# it is the only backend the lite plugin drives.
#
# The archive is verified against a pinned SHA-256 before extraction.
#
# v0.21 matters: upstream fixed "segmentation fault after hiding the keyboard"
# and "missing release on hide after key press" there — the exact path the ▼
# collapse key takes (0.20 also had no key release on hide, which could leave a
# modifier stuck).
#
# Source: GitHub's codeload archive of tag v0.21. It is a generated tarball, so
# if the digest ever stops matching the archive was re-cut upstream — re-verify
# the tree and update the pin deliberately, do not just paste a new hash.
#
# Usage:
#   tlit-install-wvkbd            build & install
#   tlit-install-wvkbd --force    rebuild even when a current lite build exists
#   tlit-install-wvkbd --check    is the installed binary lite v<pin>? (0/1)
#   tlit-install-wvkbd --dry-run  preview only
# ============================================================================
set -euo pipefail

WVKBD_VERSION="0.21"
WVKBD_URL="https://codeload.github.com/jjsullivan5196/wvkbd/tar.gz/refs/tags/v0.21"
WVKBD_SHA256="e0a88358cf5a76f812a766f9323a2633da1297bfb11a1e38d420689efdd26f9d"
MAX_ARCHIVE_BYTES=8388608

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
DATA_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/tablet-lite"
# The installed helper lives in ~/.local/bin and cannot see the repo; install.sh
# copies the patch to DATA_DIR. A dev run from the repo falls back to the
# sibling config/ directory.
PATCH="$DATA_DIR/wvkbd-hide-key.patch"
if [ ! -f "$PATCH" ]; then
  PATCH="$REPO_ROOT/config/wvkbd/wvkbd-hide-key.patch"
fi
BIN="${BIN_DIR:-$HOME/.local/bin}"
DEST="$BIN/wvkbd-deskintl"
DRY_RUN=0
CHECK=0
FORCE=0

for arg in "$@"; do
  case "$arg" in
    --dry-run) DRY_RUN=1 ;;
    --check)   CHECK=1 ;;
    --force)   FORCE=1 ;;
    -h|--help) sed -n '2,45p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "unknown option: $arg (see --help)" >&2; exit 2 ;;
  esac
done

log()  { printf '\033[1;32m==>\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33mWARN:\033[0m %s\n' "$*" >&2; }
run()  { if [ "$DRY_RUN" -eq 1 ]; then printf '    would run: %s\n' "$*"; else "$@"; fi }

[ "$DRY_RUN" -eq 1 ] && log "DRY RUN — nothing will be changed"

# The lite build is identified by the ▼ label, the ABSENCE of the full
# plugin's 手写/texp-ink-key hook, and the pinned upstream version string
# (0.20 builds are rebuilt on the next run).
has_lite_keys() {
  grep -q $'\xE2\x96\xBC' "$1" 2>/dev/null && ! grep -q 'texp-ink-key' "$1" 2>/dev/null
}

binary_has_version() {
  # No `grep -q` here: it exits early, `strings` then dies on SIGPIPE and
  # `set -o pipefail` would turn a match into a failure.
  strings "$1" 2>/dev/null | grep -x "$WVKBD_VERSION" >/dev/null
}

is_current() {
  [ -x "$DEST" ] && has_lite_keys "$DEST" && binary_has_version "$DEST"
}

if [ "$CHECK" -eq 1 ]; then
  if is_current; then
    echo "wvkbd-deskintl v$WVKBD_VERSION (lite build with ▼) at $DEST"
    exit 0
  fi
  echo "wvkbd-deskintl is missing, not the lite build, or not v$WVKBD_VERSION: $DEST" >&2
  exit 1
fi

if [ "$FORCE" -eq 0 ] && is_current; then
  log "wvkbd-deskintl v$WVKBD_VERSION (lite build with ▼) already installed: $DEST"
  exit 0
fi

if [ -x "$DEST" ] && [ "$FORCE" -eq 0 ]; then
  log "rebuilding: the installed build is not lite v$WVKBD_VERSION"
fi

if [ "$DRY_RUN" -eq 0 ]; then
  missing=()
  for pc in cairo pango wayland-client xkbcommon; do
    pkg-config --exists "$pc" 2>/dev/null || missing+=("$pc")
  done
  if [ "${#missing[@]}" -gt 0 ]; then
    warn "missing build dependencies: ${missing[*]}"
    warn "install with: sudo pacman -S --needed cairo pango wayland libxkbcommon"
    warn "until then there is no on-screen keyboard (tlit-vk will say so)"
    exit 1
  fi
  for tool in make cc curl tar patch sha256sum strings; do
    command -v "$tool" >/dev/null 2>&1 || { warn "missing tool: $tool"; exit 1; }
  done
  [ -f "$PATCH" ] || { warn "hide-key patch missing: $PATCH"; exit 1; }
fi

tmp="$(mktemp -d)"
cleanup() { rm -rf "$tmp"; }
trap cleanup EXIT

log "downloading wvkbd v$WVKBD_VERSION"
run curl -fsSL --proto '=https' --max-time 120 \
  --max-filesize "$MAX_ARCHIVE_BYTES" -o "$tmp/wvkbd.tar.gz" "$WVKBD_URL"
if [ "$DRY_RUN" -eq 0 ]; then
  echo "$WVKBD_SHA256  $tmp/wvkbd.tar.gz" | sha256sum -c - >/dev/null \
    || { warn "wvkbd source archive SHA-256 mismatch — refusing to build"; exit 1; }
  log "source archive SHA-256 verified"
  tar -xzf "$tmp/wvkbd.tar.gz" -C "$tmp"
  src="$tmp/wvkbd-v$WVKBD_VERSION"
  [ -d "$src" ] || src="$tmp/wvkbd-$WVKBD_VERSION"
  [ -d "$src" ] || src="$(find "$tmp" -mindepth 1 -maxdepth 1 -type d -name 'wvkbd*' | head -1)"
  [ -d "$src" ] || { warn "could not locate the extracted wvkbd source"; exit 1; }
  log "applying the ▼ collapse-key patch"
  ( cd "$src" && patch -p1 <"$PATCH" >/dev/null )
  log "building deskintl layout (Ctrl/Super/Alt + F-keys + numbers + arrows + ▼)"
  ( cd "$src" && make LAYOUT=deskintl >/dev/null )
  run mkdir -p "$BIN"
  run install -m 0755 "$src/wvkbd-deskintl" "$DEST"
  log "installed: $DEST"
  log "tlit-vk now uses this keyboard"
else
  printf '    would verify SHA-256 %s\n' "$WVKBD_SHA256"
  printf '    would extract, apply patch, make LAYOUT=deskintl\n'
  printf '    would install to %s\n' "$DEST"
fi
